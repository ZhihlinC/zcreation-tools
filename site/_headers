/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: interest-cohort=()

# Always revalidate every asset under /coverage/ so edits land for users
# without manual version bumps. Cost is one ETag round-trip per asset (304
# with no body) — negligible for the small surface each tool ships.
#
# Splat note: Cloudflare Pages requires `*` at end of path; mid-path globs
# like `/coverage/*.js` silently no-op. Hence the whole-subtree match. HTML
# under /coverage/ also takes no-cache, which is functionally identical to
# CF Pages' HTML default (max-age=0, must-revalidate). Each tool gets its own
# /<tool>/* block; paths here are site paths (no site/ prefix).
/coverage/*
  Cache-Control: no-cache

# /pdf/ (PDF 頁面整理): same always-revalidate policy as /coverage/.
# vendor/ is ~5.6 MB (pdf.js worker, cmaps, fonts, wasm); after the first
# visit each file costs a 304 round-trip, not a re-download.
# The CSP backs the "files never leave this tab" promise: no third-party
# origin can be contacted (connect-src self = only the tool's own vendor
# files), no inline script, no framing. wasm-unsafe-eval is for pdf.js's
# image decoders. tests/pdf/serve.js serves these headers to the browser tests.
/pdf/*
  Cache-Control: no-cache
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data:; connect-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
